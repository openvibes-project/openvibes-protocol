{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openvibes-project/openvibes-protocol/schemas/v1/feed-manifest.schema.json",
  "title": "Feed manifest (spec/feed-v1.md)",
  "description": "The signed manifest, after the envelope's `manifest` string is decoded. Unique (source, name), expires_at > created_at, and `releases` only on osv files are checked by the verifier (vectors/feed-verification.json), not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "created_at",
    "expires_at",
    "files"
  ],
  "properties": {
    "sequence": {
      "$ref": "common.schema.json#/$defs/positiveVersion"
    },
    "created_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4102444800
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4102444800
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "file": {
      "allOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "kind",
            "name",
            "sha256",
            "size",
            "fetched_at",
            "upstream"
          ],
          "properties": {
            "source": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "kind": {
              "enum": [
                "updateinfo",
                "repomd",
                "osv",
                "kev",
                "epss",
                "euvd",
                "nvd"
              ]
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,64}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8589934592
            },
            "fetched_at": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4102444800
            },
            "upstream": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            "releases": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9.-]{1,32}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "updateinfo"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "size": {
                "maximum": 268435456
              },
              "source": {
                "pattern": "^fedora-[0-9]{1,3}-[a-z0-9_]{1,16}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "repomd"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "size": {
                "maximum": 1048576
              },
              "source": {
                "pattern": "^fedora-[0-9]{1,3}-[a-z0-9_]{1,16}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "osv"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "size": {
                "maximum": 8589934592
              },
              "source": {
                "enum": [
                  "debian",
                  "ubuntu",
                  "rocky-linux",
                  "almalinux"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "kev"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "size": {
                "maximum": 67108864
              },
              "source": {
                "const": "kev"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "epss"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "size": {
                "maximum": 134217728
              },
              "source": {
                "const": "epss"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "euvd"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "size": {
                "maximum": 67108864
              },
              "source": {
                "const": "euvd"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "nvd"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "size": {
                "maximum": 536870912
              },
              "source": {
                "const": "nvd"
              }
            }
          }
        }
      ]
    }
  }
}
