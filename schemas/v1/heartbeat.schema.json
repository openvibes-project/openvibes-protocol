{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openvibes-project/openvibes-protocol/schemas/v1/heartbeat.schema.json",
  "title": "Heartbeat",
  "description": "POST /v1/heartbeat over mTLS. Any 2xx answers it.",
  "type": "object",
  "required": [
    "schema_version",
    "agent_id",
    "scanner_version",
    "observed_at_unix_ms",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "agent_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "scanner_version": {
      "$ref": "common.schema.json#/$defs/boundedString"
    },
    "hostname": {
      "$ref": "common.schema.json#/$defs/boundedString",
      "description": "Optional OS-reported operator label; never identity or authorization."
    },
    "observed_at_unix_ms": {
      "$ref": "common.schema.json#/$defs/unixMs"
    },
    "capabilities": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "health": {
      "type": "object",
      "description": "Optional (P12): the agent's health, counts and codes only. Totals are cumulative since the queue was created.",
      "required": [
        "queue",
        "storage_errors"
      ],
      "properties": {
        "queue": {
          "type": "object",
          "required": [
            "pending",
            "bytes",
            "max_bytes",
            "dropped_total"
          ],
          "properties": {
            "pending": {
              "$ref": "#/$defs/count"
            },
            "oldest_pending_age_s": {
              "$ref": "#/$defs/count"
            },
            "bytes": {
              "$ref": "#/$defs/count"
            },
            "max_bytes": {
              "$ref": "#/$defs/count"
            },
            "dropped_total": {
              "$ref": "#/$defs/count"
            },
            "rejected_total": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "additionalProperties": {
                "$ref": "#/$defs/count"
              }
            }
          }
        },
        "last_scan": {
          "type": "object",
          "required": [
            "finished_at_unix_ms",
            "interval_s",
            "rules_evaluated",
            "rules_unavailable",
            "rules_failed",
            "collectors"
          ],
          "properties": {
            "finished_at_unix_ms": {
              "$ref": "common.schema.json#/$defs/unixMs"
            },
            "interval_s": {
              "$ref": "#/$defs/count"
            },
            "rules_evaluated": {
              "$ref": "#/$defs/count"
            },
            "rules_unavailable": {
              "$ref": "#/$defs/count"
            },
            "rules_failed": {
              "$ref": "#/$defs/count"
            },
            "collectors": {
              "type": "object",
              "maxProperties": 16,
              "propertyNames": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "additionalProperties": {
                "$ref": "common.schema.json#/$defs/identifier",
                "description": "ok, permission_denied, not_found, timed_out, invalid_data, unsupported or internal; readers treat a value they do not know as a failure (later versions may add values)."
              }
            }
          }
        },
        "rule_sets": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "version": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "expires_at_unix_ms": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/unixMs"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "refused": {
                "anyOf": [
                  {
                    "$ref": "common.schema.json#/$defs/identifier"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "signature, expired, rolled_back or invalid; readers treat a value they do not know as invalid (later versions may add values)."
              }
            }
          }
        },
        "storage_errors": {
          "$ref": "#/$defs/count"
        },
        "clock_jump_s": {
          "type": [
            "integer",
            "null"
          ]
        },
        "matches_truncated": {
          "$ref": "#/$defs/count",
          "description": "Optional (P13): current matches beyond the 500 kept."
        },
        "alarms": {
          "type": "object",
          "description": "Optional (P14): process-event alarms. collector is the process_events collector's outcome (unsupported without audit or CAP_AUDIT_READ).",
          "required": [
            "collector",
            "events_dropped_total",
            "alarms_dropped_total",
            "pending",
            "platform_unsupported",
            "rules_accepted",
            "rules_refused",
            "rules_without_prefilter"
          ],
          "properties": {
            "collector": {
              "$ref": "common.schema.json#/$defs/identifier"
            },
            "events_dropped_total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "alarms_dropped_total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "pending": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "platform_unsupported": {
              "type": "boolean"
            },
            "rules_accepted": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "rules_refused": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "rules_without_prefilter": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "events_budget_cut_total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807,
              "description": "Optional: process starts whose evaluation stopped at the per-event CEL budget, since the agent started."
            }
          }
        }
      }
    },
    "match_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Optional (P13): match digest of the set the platform last acknowledged for this agent. Sent only by agents using finding changes, and left out while a change set or replace is not yet acknowledged; a platform whose stored digest differs answers 409 findings_resync after storing the heartbeat."
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
