{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openvibes-project/openvibes-protocol/schemas/v1/rule-set.schema.json",
  "title": "RuleSet",
  "description": "The payload of a SignedRuleEnvelope, in its JSON encoding. Not expressible here: rule IDs must be unique.",
  "type": "object",
  "required": [
    "schema_version",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "title",
          "severity",
          "confidence",
          "expression",
          "finding_message"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "version": {
            "$ref": "common.schema.json#/$defs/positiveVersion"
          },
          "title": {
            "$ref": "common.schema.json#/$defs/boundedString"
          },
          "severity": {
            "$ref": "common.schema.json#/$defs/severity"
          },
          "confidence": {
            "$ref": "common.schema.json#/$defs/confidence"
          },
          "expression": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "description": "Approved CEL subset only.",
            "pattern": "^[^\\u0000]*$"
          },
          "finding_message": {
            "$ref": "common.schema.json#/$defs/boundedString"
          },
          "kind": {
            "enum": ["snapshot", "process_event"],
            "description": "snapshot (default when absent): evaluated against the scan's facts. process_event (P14): evaluated once per process start against the event binding; ships in its own rule set, which older agents are not configured to load."
          },
          "programs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": { "$ref": "common.schema.json#/$defs/boundedString" },
            "description": "process_event only, optional: exact exe paths or basenames. An event whose exe and name are in no rule's list skips evaluation."
          }
        }
      }
    }
  }
}
