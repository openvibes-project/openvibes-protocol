{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/openvibes-project/openvibes-protocol/schemas/v1/inventory-export.schema.json",
  "title": "InventoryExport",
  "description": "Local-only route: one snapshot of the host's installed packages, written by the agent's export command beside its FindingExport files. Unsigned in version 1.",
  "type": "object",
  "required": [
    "schema_version",
    "install_id",
    "scanner_version",
    "collected_at_unix_ms",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "install_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "agent_id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "hostname": {
      "$ref": "common.schema.json#/$defs/boundedString"
    },
    "scanner_version": {
      "$ref": "common.schema.json#/$defs/boundedString"
    },
    "collected_at_unix_ms": {
      "$ref": "common.schema.json#/$defs/unixMs"
    },
    "packages": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "required": [
        "manager",
        "name",
        "version"
      ],
      "properties": {
        "manager": {
          "enum": [
            "rpm",
            "dpkg"
          ],
          "description": "Package database the record came from."
        },
        "name": {
          "$ref": "common.schema.json#/$defs/boundedString"
        },
        "version": {
          "$ref": "common.schema.json#/$defs/boundedString",
          "description": "Upstream version, without epoch or distribution release."
        },
        "release": {
          "$ref": "common.schema.json#/$defs/boundedString",
          "description": "Distribution release or Debian revision."
        },
        "epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "arch": {
          "$ref": "common.schema.json#/$defs/boundedString"
        },
        "vendor": {
          "$ref": "common.schema.json#/$defs/boundedString",
          "description": "Vendor as the package database records it (RPM VENDOR); absent for dpkg."
        }
      }
    }
  }
}
