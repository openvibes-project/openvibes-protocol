[
  {
    "name": "mysql -p value is masked",
    "exe": "/usr/bin/mysql",
    "args": [
      "mysql",
      "-u",
      "app",
      "-psecret",
      "shop"
    ],
    "masked": [
      "mysql",
      "-u",
      "app",
      "-p***",
      "shop"
    ]
  },
  {
    "name": "mysql bare -p prompts, next word is kept",
    "exe": "/usr/bin/mysql",
    "args": [
      "mysql",
      "-p",
      "shop"
    ],
    "masked": [
      "mysql",
      "-p",
      "shop"
    ]
  },
  {
    "name": "sshpass -p next argument is masked",
    "exe": "/usr/bin/sshpass",
    "args": [
      "sshpass",
      "-p",
      "secret",
      "ssh",
      "host"
    ],
    "masked": [
      "sshpass",
      "-p",
      "***",
      "ssh",
      "host"
    ]
  },
  {
    "name": "ssh -p is a port",
    "exe": "/usr/bin/ssh",
    "args": [
      "ssh",
      "-p",
      "2222",
      "host"
    ],
    "masked": [
      "ssh",
      "-p",
      "2222",
      "host"
    ]
  },
  {
    "name": "the -p gate uses the exe basename, not argv[0]",
    "exe": "/usr/bin/ssh",
    "args": [
      "mysql",
      "-p2222",
      "host"
    ],
    "masked": [
      "mysql",
      "-p2222",
      "host"
    ]
  },
  {
    "name": "--password=value",
    "exe": "/usr/bin/tool",
    "args": [
      "tool",
      "--password=secret"
    ],
    "masked": [
      "tool",
      "--password=***"
    ]
  },
  {
    "name": "--password value",
    "exe": "/usr/bin/tool",
    "args": [
      "tool",
      "--password",
      "secret",
      "x"
    ],
    "masked": [
      "tool",
      "--password",
      "***",
      "x"
    ]
  },
  {
    "name": "flag names are case-insensitive",
    "exe": "/usr/bin/tool",
    "args": [
      "tool",
      "--PASSWORD=secret",
      "--Token",
      "abc"
    ],
    "masked": [
      "tool",
      "--PASSWORD=***",
      "--Token",
      "***"
    ]
  },
  {
    "name": "environment-style assignment",
    "exe": "/usr/bin/env",
    "args": [
      "env",
      "PGPASSWORD=secret",
      "MY_API_KEY=abc",
      "HOME=/root",
      "psql"
    ],
    "masked": [
      "env",
      "PGPASSWORD=***",
      "MY_API_KEY=***",
      "HOME=/root",
      "psql"
    ]
  },
  {
    "name": "URL userinfo password",
    "exe": "/usr/bin/git",
    "args": [
      "git",
      "clone",
      "https://bob:secret@example.org/r.git"
    ],
    "masked": [
      "git",
      "clone",
      "https://bob:***@example.org/r.git"
    ]
  },
  {
    "name": "URL without a password is kept",
    "exe": "/usr/bin/git",
    "args": [
      "git",
      "clone",
      "https://bob@example.org/r.git"
    ],
    "masked": [
      "git",
      "clone",
      "https://bob@example.org/r.git"
    ]
  },
  {
    "name": "curl -u user:password",
    "exe": "/usr/bin/curl",
    "args": [
      "curl",
      "-u",
      "bob:secret",
      "https://x"
    ],
    "masked": [
      "curl",
      "-u",
      "bob:***",
      "https://x"
    ]
  },
  {
    "name": "curl --user=user:password",
    "exe": "/usr/bin/curl",
    "args": [
      "curl",
      "--user=bob:secret",
      "https://x"
    ],
    "masked": [
      "curl",
      "--user=bob:***",
      "https://x"
    ]
  },
  {
    "name": "Authorization header value",
    "exe": "/usr/bin/curl",
    "args": [
      "curl",
      "-H",
      "authorization: Bearer abc.def",
      "https://x"
    ],
    "masked": [
      "curl",
      "-H",
      "authorization: ***",
      "https://x"
    ]
  },
  {
    "name": "openssl pass: argument",
    "exe": "/usr/bin/openssl",
    "args": [
      "openssl",
      "enc",
      "-pass",
      "pass:secret",
      "-in",
      "f"
    ],
    "masked": [
      "openssl",
      "enc",
      "-pass",
      "pass:***",
      "-in",
      "f"
    ]
  },
  {
    "name": "inside sh -c, words are masked per command",
    "exe": "/usr/bin/sh",
    "args": [
      "sh",
      "-c",
      "mysql -u app -psecret shop"
    ],
    "masked": [
      "sh",
      "-c",
      "mysql -u app -p*** shop"
    ]
  },
  {
    "name": "inside sh -c, the command changes after &&",
    "exe": "/usr/bin/bash",
    "args": [
      "bash",
      "-c",
      "cd /srv && mysql -psecret db"
    ],
    "masked": [
      "bash",
      "-c",
      "cd /srv && mysql -p*** db"
    ]
  },
  {
    "name": "inside sh -c, -p of another command is kept",
    "exe": "/usr/bin/sh",
    "args": [
      "sh",
      "-c",
      "ssh -p2222 host"
    ],
    "masked": [
      "sh",
      "-c",
      "ssh -p2222 host"
    ]
  },
  {
    "name": "inside sh -c, assignments and flags are masked",
    "exe": "/usr/bin/dash",
    "args": [
      "dash",
      "-c",
      "PGPASSWORD=secret psql --password=x"
    ],
    "masked": [
      "dash",
      "-c",
      "PGPASSWORD=*** psql --password=***"
    ]
  },
  {
    "name": "bash -lc: -c inside a flag cluster",
    "exe": "/usr/bin/bash",
    "args": [
      "bash",
      "-lc",
      "mysql -psecret db"
    ],
    "masked": [
      "bash",
      "-lc",
      "mysql -p*** db"
    ]
  },
  {
    "name": "busybox is a shell when argv[0] is one",
    "exe": "/usr/bin/busybox",
    "args": [
      "sh",
      "-c",
      "mysql -psecret db"
    ],
    "masked": [
      "sh",
      "-c",
      "mysql -p*** db"
    ]
  },
  {
    "name": "su -c script is masked",
    "exe": "/usr/bin/su",
    "args": [
      "su",
      "-",
      "postgres",
      "-c",
      "PGPASSWORD=secret psql -c 'select 1'"
    ],
    "masked": [
      "su",
      "-",
      "postgres",
      "-c",
      "PGPASSWORD=*** psql -c 'select 1'"
    ]
  },
  {
    "name": "runuser -c script is masked",
    "exe": "/usr/sbin/runuser",
    "args": [
      "runuser",
      "-l",
      "app",
      "-c",
      "mysql -psecret db"
    ],
    "masked": [
      "runuser",
      "-l",
      "app",
      "-c",
      "mysql -p*** db"
    ]
  },
  {
    "name": "a newline does not hide the program word",
    "exe": "/usr/bin/sh",
    "args": [
      "sh",
      "-c",
      "cd /srv\nmysql -psecret db"
    ],
    "masked": [
      "sh",
      "-c",
      "cd /srv\nmysql -p*** db"
    ]
  },
  {
    "name": "program word after a subshell parenthesis",
    "exe": "/usr/bin/sh",
    "args": [
      "sh",
      "-c",
      "(mysql -psecret db)"
    ],
    "masked": [
      "sh",
      "-c",
      "(mysql -p*** db)"
    ]
  },
  {
    "name": "program word after command substitution",
    "exe": "/usr/bin/sh",
    "args": [
      "sh",
      "-c",
      "echo $(mysql -psecret -e 'select 1')"
    ],
    "masked": [
      "sh",
      "-c",
      "echo $(mysql -p*** -e 'select 1')"
    ]
  },
  {
    "name": "program word as a full path in a script",
    "exe": "/usr/bin/sh",
    "args": [
      "sh",
      "-c",
      "/usr/bin/mysql -psecret db"
    ],
    "masked": [
      "sh",
      "-c",
      "/usr/bin/mysql -p*** db"
    ]
  },
  {
    "name": "sudo wrapper: program word in plain args",
    "exe": "/usr/bin/sudo",
    "args": [
      "sudo",
      "-u",
      "mysql",
      "mysql",
      "-psecret",
      "db"
    ],
    "masked": [
      "sudo",
      "-u",
      "mysql",
      "mysql",
      "-p***",
      "db"
    ]
  },
  {
    "name": "timeout wrapper",
    "exe": "/usr/bin/timeout",
    "args": [
      "timeout",
      "10",
      "mysqldump",
      "-psecret",
      "db"
    ],
    "masked": [
      "timeout",
      "10",
      "mysqldump",
      "-p***",
      "db"
    ]
  },
  {
    "name": "docker exec wrapper",
    "exe": "/usr/bin/docker",
    "args": [
      "docker",
      "exec",
      "db",
      "mariadb",
      "-psecret"
    ],
    "masked": [
      "docker",
      "exec",
      "db",
      "mariadb",
      "-p***"
    ]
  },
  {
    "name": "program word keeps -p masking on for later words",
    "exe": "/usr/bin/sh",
    "args": [
      "sh",
      "-c",
      "mysqldump -psecret db | ssh -p22 backup"
    ],
    "masked": [
      "sh",
      "-c",
      "mysqldump -p*** db | ssh -p*** backup"
    ]
  },
  {
    "name": "argv[0] is not a program word",
    "exe": "/usr/bin/ssh",
    "args": [
      "mysql",
      "-p",
      "2222",
      "-p2222",
      "host"
    ],
    "masked": [
      "mysql",
      "-p",
      "2222",
      "-p2222",
      "host"
    ]
  },
  {
    "name": "sshpass as a program word masks -p value",
    "exe": "/usr/bin/sh",
    "args": [
      "sh",
      "-c",
      "sshpass -p secret ssh host"
    ],
    "masked": [
      "sh",
      "-c",
      "sshpass -p *** ssh host"
    ]
  },
  {
    "name": "-p after -- is still masked for mysql",
    "exe": "/usr/bin/mysql",
    "args": [
      "mysql",
      "--",
      "-psecret"
    ],
    "masked": [
      "mysql",
      "--",
      "-p***"
    ]
  },
  {
    "name": "--NAME suffix: --db-password=",
    "exe": "/usr/bin/tool",
    "args": [
      "tool",
      "--db-password=secret"
    ],
    "masked": [
      "tool",
      "--db-password=***"
    ]
  },
  {
    "name": "--NAME suffix: --client-secret next argument",
    "exe": "/usr/bin/tool",
    "args": [
      "tool",
      "--client-secret",
      "secret",
      "x"
    ],
    "masked": [
      "tool",
      "--client-secret",
      "***",
      "x"
    ]
  },
  {
    "name": "--NAME suffix: gpg --passphrase",
    "exe": "/usr/bin/gpg",
    "args": [
      "gpg",
      "--batch",
      "--passphrase",
      "secret",
      "-c",
      "f"
    ],
    "masked": [
      "gpg",
      "--batch",
      "--passphrase",
      "***",
      "-c",
      "f"
    ]
  },
  {
    "name": "--NAME suffix over-masks --no-password, accepted",
    "exe": "/usr/bin/psql",
    "args": [
      "psql",
      "--no-password",
      "shop"
    ],
    "masked": [
      "psql",
      "--no-password",
      "***"
    ]
  },
  {
    "name": "-NAME: keytool -storepass and -keypass",
