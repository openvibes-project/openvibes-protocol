    "args": [
      "keytool",
      "-list",
      "-storepass",
      "secret",
      "-keypass",
      "secret2"
    ],
    "masked": [
      "keytool",
      "-list",
      "-storepass",
      "***",
      "-keypass",
      "***"
    ]
  },
  {
    "name": "-NAME: -password=value",
    "exe": "/usr/bin/tool",
    "args": [
      "tool",
      "-password=secret"
    ],
    "masked": [
      "tool",
      "-password=***"
    ]
  },
  {
    "name": "single-dash -pass is not a -NAME flag, pass: masks its value",
    "exe": "/usr/bin/openssl",
    "args": [
      "openssl",
      "enc",
      "-pass",
      "pass:secret",
      "-in",
      "f"
    ],
    "masked": [
      "openssl",
      "enc",
      "-pass",
      "pass:***",
      "-in",
      "f"
    ]
  },
  {
    "name": "empty --password= stays empty and the next argument is kept",
    "exe": "/usr/bin/tool",
    "args": [
      "tool",
      "--password=",
      "next"
    ],
    "masked": [
      "tool",
      "--password=",
      "next"
    ]
  },
  {
    "name": "case folding is ASCII only",
    "exe": "/usr/bin/tool",
    "args": [
      "tool",
      "--api-Key=secret"
    ],
    "masked": [
      "tool",
      "--api-Key=secret"
    ]
  },
